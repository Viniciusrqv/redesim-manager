# =====================================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA SEUS DADOS
# =====================================================
# cp .env.example .env

# ---- TELEGRAM (recomendado) ----
# 1. Abra o Telegram e procure por @BotFather
# 2. Digite /newbot e siga as instruções
# 3. Copie o TOKEN que ele te enviar
TELEGRAM_BOT_TOKEN=

# 4. Para descobrir seu CHAT_ID, procure @userinfobot no Telegram e
#    envie /start. Ele te informará seu ID numérico.
TELEGRAM_CHAT_ID=

# ---- SMS via TWILIO (opcional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# ---- CONFIGURAÇÕES GERAIS ----
# Regra REDESIM: CLI deve sair em até 4 dias úteis.
# DIAS_AMARELO  = entra em alerta preventivo (>= 3 dias parado)
# DIAS_VERMELHO = prazo máximo (>= 4 dias parado — NÃO pode passar disso)
DIAS_AMARELO=3
DIAS_VERMELHO=4

# Horário(s) do envio DIÁRIO de lembretes (formato HH:MM).
# Aceita um único horário ou vários separados por vírgula.
# Exemplos: "09:00"  |  "10:00,15:00"  |  "08:00,12:00,17:00"
HORARIO_LEMBRETE=10:00,15:00

# Caminho do banco SQLite (uso local — desenvolvimento)
DATABASE_PATH=data/redesim.db

# Nome do responsável padrão (preenche automaticamente ao criar processos)
RESPONSAVEL_PADRAO=Vinicius

# ====================================================================
# PRODUÇÃO — SUPABASE (Postgres + Auth + Storage)
# ====================================================================
# Quando DATABASE_URL está setada, o app usa Postgres do Supabase.
# Quando vazia, cai pra SQLite local (DATABASE_PATH acima).
#
# Como pegar a DATABASE_URL:
#   1. Abrir https://supabase.com/dashboard/project/<seu-ref>/settings/database
#   2. Em "Connection string" → escolher "URI" → "Transaction pooler"
#   3. Copiar e colar abaixo (já vem com placeholder [YOUR-PASSWORD])
#   4. Trocar [YOUR-PASSWORD] pela senha do banco
DATABASE_URL=

# URL do projeto Supabase (usada pra Auth e Storage)
# Exemplo: https://ghftrapzckxhikyxahrr.supabase.co
SUPABASE_URL=

# Chave PÚBLICA "anon" (Project Settings → API → anon public)
# Pode ser exposta no front-end — é a chave usada pelo Auth do login.
SUPABASE_ANON_KEY=

# Chave SECRETA "service_role" (Project Settings → API → service_role)
# ⚠️ NUNCA exponha — bypass de RLS. Use APENAS no servidor pra migração inicial.
SUPABASE_SERVICE_KEY=

# ---- GESTTA (API privada) ----
# Token JWT do GESTTA. Como pegar:
#   1. Abrir https://app.gestta.com.br logado
#   2. F12 → Application → Local Storage → app.gestta.com.br
#   3. Copiar o valor da chave `ngStorage-jwt`
#   4. Colar abaixo SEM as aspas externas (mantenha o "JWT " no início)
# ⚠️ Expira em ~24h. Em produção, atualize via página "⚙️ Configurações"
#    dentro do app.
GESTTA_JWT=
